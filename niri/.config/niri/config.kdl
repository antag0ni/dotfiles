// =============================================================================
// niri configuration
// =============================================================================
//
// Format : KDL (https://kdl.dev). Prefixing a node with "/-" disables it.
// Docs   : https://niri-wm.github.io/niri/Configuration:-Introduction
//
// Layout of this file
//   1. Input             keyboard, touchpad
//   2. Appearance        cursor, client-side decorations
//   3. Outputs           handled by kanshi (no `output` nodes here)
//   4. Layout            gaps, column widths, focus ring, border, shadow
//   5. Startup           autostart programs, hotkey overlay
//   6. Screenshots       save location
//   7. Window rules      per-application behaviour
//   8. Keybindings       everything inside `binds { }`
//
// Editing tips
//   - niri reloads this file automatically when it is saved.
//   - Check syntax without applying:  niri validate -c config.kdl
//   - Find XKB key names with `wev`; find output names with `niri msg outputs`.
//   - Any bind can also be triggered from a shell: niri msg action <action>
// =============================================================================


// =============================================================================
// 1. INPUT
// https://niri-wm.github.io/niri/Configuration:-Input
// Settings that are omitted keep their libinput/niri defaults.
// =============================================================================
input {
    keyboard {
        // Left empty on purpose: niri then reads the layout from
        // org.freedesktop.locale1 (set it with `localectl set-x11-keymap`).
        // To override here, add e.g.:  layout "it"   options "ctrl:nocaps"
        // See xkeyboard-config(7) for the available rules/model/layout/variant/options.
        xkb {
        }

        // Turn NumLock on at startup (omitting this line leaves it off).
        numlock
    }

    touchpad {
        tap             // tap-to-click
        natural-scroll  // content follows the fingers
    }
}


// =============================================================================
// 2. APPEARANCE
// =============================================================================
cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// Ask clients to drop their client-side decorations (title bars, rounded
// corners). Clients that insist on CSD are still honoured. This also fixes
// border/focus-ring drawing behind semi-transparent windows.
// Restart applications after toggling this for it to take effect.
prefer-no-csd


// =============================================================================
// 3. OUTPUTS
// Monitors are configured by kanshi (started in section 5), so there are no
// `output` nodes here. To let niri manage a monitor itself, add:
//   output "<name>" { mode "1920x1080@60"; scale 1; position x=0 y=0; }
// Output names come from `niri msg outputs`.
// https://niri-wm.github.io/niri/Configuration:-Outputs
// =============================================================================


// =============================================================================
// 4. LAYOUT
// https://niri-wm.github.io/niri/Configuration:-Layout
// All sizes are in logical (scaled) pixels unless stated otherwise.
// =============================================================================
layout {
    // Solid background color
    // background-color "#3c3836"
    background-color "#000000"

    // Space between windows and around the screen edge.
    gaps 0

    // When to centre a column after focus changes: "never" | "always" | "on-overflow".
    center-focused-column "never"

    // Width of newly opened columns (here: half of the output width).
    // An empty `{}` lets each window pick its own initial width.
    default-column-width { proportion 0.5; }

    // Widths cycled through by Mod+R / Mod+Shift+R (fractions of the output width).
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Ring drawn around the focused window. Disabled: the border below is used
    // instead. Remove `off` to enable it (width/colors are kept ready).
    focus-ring {
        off
        width 4
        active-color "#7fc8ff"      // focused monitor
        inactive-color "#505050"    // other monitors
    }

    // Always-visible border around windows.
    border {
        width 1
        active-color "#555555"
        inactive-color "#1f1f1f"
        urgent-color "#9b0000"      // windows requesting attention
    }

    // Drop shadows. Not active until `on` is added; values mirror CSS box-shadow.
    shadow {
        softness 30                 // blur radius
        spread 5
        offset x=0 y=5
        color "#0007"               // #rrggbbaa
    }
}


// =============================================================================
// 5. STARTUP
// =============================================================================

// Shell/bar/launcher/lock screen. Several binds below call `noctalia msg ...`.
spawn-at-startup "noctalia"

// Output profile daemon (see section 3).
spawn-at-startup "kanshi"

// Use spawn-sh-at-startup for commands needing a shell (pipes, variables).
// Programs can also autostart through xdg-desktop-autostart.

// Do not show the "Important Hotkeys" pop-up at login (Mod+Shift+\ opens it).
hotkey-overlay {
    skip-at-startup
}


// =============================================================================
// 6. SCREENSHOTS
// =============================================================================

// Where screenshots are written. "~" expands to $HOME and the path goes through
// strftime(3), so date/time placeholders work. Use `screenshot-path null` to
// keep screenshots in the clipboard only.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// =============================================================================
// 7. WINDOW RULES
// https://niri-wm.github.io/niri/Configuration:-Window-Rules
// Each `match` selects windows by app-id and/or title (regular expressions).
// =============================================================================

// WezTerm: an empty default-column-width works around its bad initial configure.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Firefox Picture-in-Picture opens as a floating window. The app-id pattern
// matches both native ("firefox") and Flatpak ("org.mozilla.firefox") builds.
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}


// =============================================================================
// 8. KEYBINDINGS
//
// Syntax:  <Modifiers+Key> [properties] { <action>; }
//   - "Mod" is Super on a TTY session and Alt when niri runs as a nested window.
//   - spawn "prog" "arg" ...   runs a program, one quoted string per argument.
//   - spawn-sh "cmd"           runs a whole string through `sh -c` (pipes etc.).
//
// Bind properties used below:
//   allow-when-locked=true      works while the session is locked
//   allow-inhibiting=false      works even if an app inhibits shortcuts
//   repeat=false                no key-repeat while held
//   cooldown-ms=N               rate-limit (useful for mouse wheel binds)
//   hotkey-overlay-title="..."  label in the hotkey overlay (null hides the bind)
//
// Conventions: arrow keys and h/j/k/l are equivalent. Adding Ctrl moves the
// thing instead of focusing it; adding Shift targets monitors or workspaces.
// =============================================================================
binds {

    // ---- Applications ------------------------------------------------------
    Mod+T     hotkey-overlay-title="Open a Terminal"      { spawn "alacritty"; }
    Mod+D     hotkey-overlay-title="Launcher"             { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B     hotkey-overlay-title="Open Browser"         { spawn "firefox"; }
    Mod+E     hotkey-overlay-title="Open File Explorer"   { spawn "nautilus"; }
    Mod+Alt+L hotkey-overlay-title="Lock the Screen"      { spawn-sh "noctalia msg session lock"; }

    // Toggle the Orca screen reader (starts it, or kills it if running).
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Show the list of important hotkeys.
    Mod+Shift+Backslash { show-hotkey-overlay; }

    // ---- Audio, media and brightness ---------------------------------------
    // Volume via PipeWire/WirePlumber (wpctl); raise is capped at 100% (-l 1.0).
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // Media keys via playerctl (any MPRIS-capable player).
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop         allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }

    // Backlight via brightnessctl (plain `spawn`: each argument quoted separately).
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // ---- Windows: basics ---------------------------------------------------
    Mod+O repeat=false { toggle-overview; }    // zoomed-out view of all workspaces/windows
    Mod+Q repeat=false { close-window; }

    // ---- Focus -------------------------------------------------------------
    // Left/right move between columns, up/down between windows in a column.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // ---- Move columns and windows ------------------------------------------
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // ---- Monitors ----------------------------------------------------------
    // Shift: focus another monitor. Shift+Ctrl: send the focused column there.
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // ---- Workspaces: relative navigation -----------------------------------
    // Plain: focus workspace. Ctrl: move the column to it. Shift: move the
    // workspace itself up/down in the stack.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // ---- Workspaces: by index ----------------------------------------------
    // Best effort: niri workspaces are dynamic, so an index past the last used
    // workspace refers to the bottommost (empty) one.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // ---- Mouse wheel -------------------------------------------------------
    // Directions follow the natural-scroll setting. The cooldown stops the
    // workspace switch from firing too fast.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Shift + vertical wheel scrolls horizontally, as in most applications.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // ---- Columns: merge / split --------------------------------------------
    // A lone window is pulled into the neighbouring column; a window already
    // in a column is pushed out of it.
    Mod+ograve { consume-or-expel-window-left; }    // "ò" key (Italian layout)
    Mod+agrave { consume-or-expel-window-right; }   // "à" key (Italian layout)

    // Pull the next window from the right into the bottom of this column /
    // push the bottom window of this column out to the right.
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // ---- Sizing ------------------------------------------------------------
    Mod+R            { switch-preset-column-width; }        // cycle preset-column-widths
    Mod+Shift+R      { switch-preset-column-width-back; }   // ...in reverse
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    Mod+F       { maximize-column; }                  // keeps gaps and borders
    Mod+Shift+F { fullscreen-window; }
    Mod+M       { maximize-window-to-edges; }         // true maximize, no gaps
    Mod+Ctrl+F  { expand-column-to-available-width; } // fill space left by other columns

    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // Fine adjustments (also accept pixels, e.g. "+50", or "25%").
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Plus        { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Plus  { set-window-height "+10%"; }

    // ---- Floating and tabbed -----------------------------------------------
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       { toggle-column-tabbed-display; }   // column windows become vertical tabs

    // ---- Screenshots (saved to screenshot-path, section 6) ------------------
    Print      { screenshot; }          // interactive region selection
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // ---- Session -----------------------------------------------------------
    // Escape hatch: toggles the shortcut inhibitor so a misbehaving app
    // (remote desktop, KVM) cannot swallow your keybindings.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // quit asks for confirmation before exiting.
    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { quit; }

    // Turn monitors off; any input wakes them.
    Mod+Shift+P { power-off-monitors; }
}

